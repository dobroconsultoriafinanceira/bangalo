# Bloco do Bangalô — TLS automático via Let's Encrypt.
#
# Este arquivo NÃO é usado em produção: na VPS quem serve 80/443 é o Caddy do
# stack do Dobro (/root/dobro). O conteúdo abaixo é o bloco que deve ser
# copiado para /root/dobro/Caddyfile (ao lado dos blocos do site e do
# dashboard) e recarregado com:
#
#   docker compose -f /root/dobro/docker-compose.yml exec caddy caddy reload \
#       --config /etc/caddy/Caddyfile
#
# PRÉ-REQUISITOS
#   1. registro A `bangalo` -> IP da VPS no DNS de dobroconsultoria.com.br,
#      propagado ANTES do reload (senão a emissão do certificado falha);
#   2. o container bangalo_web precisa estar na mesma rede docker do Caddy
#      (rede externa `dobro_frontend`, ver docker-compose.yml deste repo).
#
# Uso alternativo (VPS sem Caddy): `docker compose --profile com-caddy up -d`
# usa este arquivo como está.

bangalo.dobroconsultoria.com.br {
    encode gzip
    reverse_proxy bangalo_web:8000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        -Server
    }

    log {
        output file /var/log/caddy/bangalo-access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
