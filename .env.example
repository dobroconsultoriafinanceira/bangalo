# ===== Bangalô — variáveis de ambiente (copie para .env e preencha) =====

# Ambiente: development | production (sem valor, o app assume production)
FLASK_ENV=development

# Chave de sessão — OBRIGATÓRIA em produção (mín. 32 caracteres; o app não sobe com chave fraca).
# Gere: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar a chave encerra todas as sessões e invalida links de senha pendentes.
SECRET_KEY=

# Endereço público do sistema (links do e-mail de recuperação de senha)
APP_BASE_URL=https://bangalo.dobroconsultoria.com.br
# Proxies reversos confiáveis na frente do app (Caddy = 1). Produção assume 1.
TRUST_PROXY=
# Sessão: tempo máximo (horas) e encerramento por inatividade (minutos)
SESSAO_MAXIMA_HORAS=12
SESSAO_INATIVIDADE_MIN=120

# Banco de dados
# Dev (SQLite): deixe vazio que o app usa instance/bangalo_dev.db
# Prod (Postgres no compose): postgresql://bangalo:SENHA@db:5432/bangalo
DATABASE_URL=

# Postgres (usados pelo serviço `db` do docker-compose)
POSTGRES_USER=bangalo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=bangalo

# E-mail transacional (SMTP Hostinger) — recuperação de senha / notificações
MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Admin inicial criado pelo seed. Senha: mín. 10 caracteres, letras + números/símbolos.
# Vazia = o seed gera uma senha aleatória e mostra uma única vez.
ADMIN_EMAIL=admin@dobroconsultoria.com.br
ADMIN_PASSWORD=

# Fuso horário
TZ=America/Sao_Paulo

# Gunicorn (produção) — VPS de 1 vCPU: 2 workers
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# Jobs agendados (APScheduler): true para ligar
SCHEDULER_ENABLED=false

# ===== Sincronização automática do fluxo com o Google Sheets (só leitura) =====
# Conta de serviço do Google com a planilha compartilhada como Leitor (ver README).
GOOGLE_SYNC_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=   # caminho do JSON da conta de serviço (fora do repo)
GOOGLE_SHEETS_FLUXO_ID=1COW3BTVTLIosPCtobxNvDxLm6wt45AieTV6UzB33XV0
GOOGLE_SYNC_INTERVAL_MIN=15

# ===== Integração Stone (Conciliação) — opcional =====
# Credenciais atreladas ao(s) Stone Code(s) da loja. A cliente solicita à
# Stone (ver README › Integração Stone). Deixe em branco para desabilitar.
STONE_BASE_URL=
STONE_CLIENT_APPLICATION_KEY=
STONE_SECRET_KEY=
STONE_CODES=            # Stone Codes da loja, separados por vírgula
STONE_LANCAR_TAXA=false # true = lança a taxa (MDR) como saída em Despesas Bancárias

# ===== Integração Itaú PJ (API de Extrato Conta Corrente) — opcional =====
# client_id/secret gerados em devportal.itau.com.br/baas/#/credentials; o
# certificado é emitido por `flask itau-certificado` (ver README).
ITAU_AMBIENTE=producao   # producao | homologacao
ITAU_CLIENT_ID=
ITAU_CLIENT_SECRET=
ITAU_CERT_DIR=           # padrão: instance/itau (fora do git)
ITAU_CERT_PATH=          # padrão: ITAU_CERT_DIR/itau.crt
ITAU_KEY_PATH=           # padrão: ITAU_CERT_DIR/itau.key
ITAU_CONTAS=             # agência-conta-DAC (ex.: 1234-12345-6), separadas por vírgula
ITAU_SYNC_ENABLED=false  # true = busca o extrato automaticamente
ITAU_SYNC_INTERVAL_MIN=60
ITAU_SYNC_DIAS=35        # quantos dias para trás cada sincronização busca
EMPRESA_CNPJ_RAIZ=       # 8 primeiros dígitos do CNPJ da empresa (reconhece contas próprias, ex.: Stone)
