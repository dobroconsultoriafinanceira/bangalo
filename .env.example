# ===== Bangalô — variáveis de ambiente (copie para .env e preencha) =====

# Ambiente: development | production
FLASK_ENV=development

# Chave de sessão — gere uma forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave

# Banco de dados
# Dev (SQLite): deixe vazio que o app usa instance/bangalo_dev.db
# Prod (Postgres no compose): postgresql://bangalo:SENHA@db:5432/bangalo
DATABASE_URL=

# Postgres (usados pelo serviço `db` do docker-compose)
POSTGRES_USER=bangalo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=bangalo

# E-mail transacional (SMTP Hostinger) — recuperação de senha / notificações
MAIL_SERVER=smtp.hostinger.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Admin inicial criado pelo seed (troque a senha no primeiro login)
ADMIN_EMAIL=admin@dobroconsultoriafinanceira.com.br
ADMIN_PASSWORD=troque-no-primeiro-login

# Fuso horário
TZ=America/Sao_Paulo

# Jobs agendados (APScheduler): true para ligar
SCHEDULER_ENABLED=false

# ===== Integração Stone (Conciliação) — opcional =====
# Credenciais atreladas ao(s) Stone Code(s) da loja. A cliente solicita à
# Stone (ver README › Integração Stone). Deixe em branco para desabilitar.
STONE_BASE_URL=
STONE_CLIENT_APPLICATION_KEY=
STONE_SECRET_KEY=
STONE_CODES=            # Stone Codes da loja, separados por vírgula
STONE_LANCAR_TAXA=false # true = lança a taxa (MDR) como saída em Despesas Bancárias

# ===== Integração Itaú PJ (API direta) — opcional =====
# OAuth2 client_credentials + mTLS. client_id/secret e os certificados são
# gerados no portal developer.itau.com.br com apoio do gerente (ver README).
ITAU_BASE_URL=
ITAU_CLIENT_ID=
ITAU_CLIENT_SECRET=
ITAU_CERT_PATH=          # caminho do certificado da aplicação (mTLS)
ITAU_KEY_PATH=           # caminho da chave privada do certificado
ITAU_SCOPES=
ITAU_CONTAS=             # contas a sincronizar, separadas por vírgula
